# Run: python scripts/bootstrap.py. Do not copy these placeholders to production.
WFS_ADMIN_PASSWORD_HASH=__HASH__
WFS_SESSION_SECRET=__SECRET__
WFS_COOKIE_SECURE=false
WFS_ALLOWED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WFS_PROVIDER_URL=https://api.openai.com/v1/responses
WFS_MAX_TASKS=8
WFS_MAX_PARALLEL=2
WFS_MAX_MODEL_CALLS=24
WFS_MAX_TOTAL_TOKENS=300000
# Optional: use a stronger model for planning and cheaper one for coding.
WFS_MODEL_MASTER=
WFS_MODEL_WORKER=
WFS_MODEL_QA=
# Override default output budget per role only if needed (large files may need more).
# WFS_OUTPUT_TOKENS=12000


# Human task gate waiting timeout (seconds); default 86400 (24h)
WFS_TASK_REVIEW_TIMEOUT_SECONDS=86400

# Multi-project execution cap; scale worker containers to match.
WFS_MAX_ACTIVE_PROJECTS=3
# Optional estimate ceiling per project. Set model rates in AI Cost Center first. 0 = disabled.
WFS_MAX_ESTIMATED_COST_USD=0

# v3.2 OPTIONAL dynamic preview authority; disabled unless you have a separately
# operated Linux authority socket and isolated HTTPS gateway. Never put secrets in git.
# WFS_PREVIEW_AUTHORITY_REQUIRED=1
# WFS_PREVIEW_AUTHORITY_SOCKET=/run/wfs-preview/authority/authority.sock
# WFS_PREVIEW_AUTHORITY_UID=<operator-approved UID>
# WFS_PREVIEW_AUTHORITY_KEY=<separately managed >=32-char secret>

# v3.3: OPTIONAL cross-host preview authority. All files must be operator-owned,
# never mount WFS DB or Docker credentials into the gateway. Do not use without
# a real private network, reviewed firewall, independent CA and short-lived certs.
# WFS_PREVIEW_AUTHORITY_MODE=mtls
# WFS_PREVIEW_AUTHORITY_URL=https://10.20.30.4:9443
# WFS_PREVIEW_AUTHORITY_CA=/run/secrets/wfs_auth_ca.pem
# WFS_PREVIEW_AUTHORITY_CERT=/run/secrets/wfs_gateway_client.pem
# WFS_PREVIEW_AUTHORITY_CLIENT_KEY=/run/secrets/wfs_gateway_client.key

# v4.0 OPTIONAL Linux-only shared SSE quota authority (OFF by default).
# Requires separately started private UDS admission service and secure operator secret.
# WFS_SSE_EDGE_SOCKET=/run/user/<uid>/wfs-sse/admission.sock
# WFS_SSE_EDGE_SECRET=<secret >=32 characters; NEVER commit>
# WFS_SSE_EDGE_ASSERTIONS=1  # Requires daemon --identity-db; no fallback
